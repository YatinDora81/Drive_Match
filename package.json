{
  "name": "drive-match",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run generate --filter=@repo/db",
    "db:migrate": "turbo run migrate --filter=@repo/db",
    "db:deploy": "turbo run deploy --filter=@repo/db",
    "db:studio": "turbo run studio --filter=@repo/db",
    "db:seed": "turbo run seed --filter=@repo/db",
    "catalogue:generate": "turbo run generate --filter=@repo/catalogue",
    "catalogue:index": "turbo run index --filter=@repo/search",
    "qdrant:init": "turbo run qdrant:init --filter=@repo/search",
    "smoke": "bun --env-file=.env scripts/smoke.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
